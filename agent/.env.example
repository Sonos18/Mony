# Cổng mô hình: LiteLLM proxy (hoặc bất kỳ endpoint tương thích OpenAI dùng API key chính thức)
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=sk-litellm-...
LLM_MODEL=claude-sonnet
# Giá ước tính khi cổng không trả chi phí, VND cho 1 triệu token
LLM_PRICE_IN_PER_M=75000
LLM_PRICE_OUT_PER_M=375000

# Trang công khai (Cloudflare Pages) và token ghi sổ cái
SITE_URL=https://mony.pages.dev
SITE_ADMIN_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789

# Lớp kiểm soát: đơn trên ngưỡng này cần người duyệt
APPROVAL_THRESHOLD_VND=2000000
DATA_DIR=./data
START_DATE=2026-10-28
