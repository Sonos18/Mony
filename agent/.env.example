# Mô hình: mặc định gọi thẳng OpenAI. Bật chia sẻ dữ liệu ở platform.openai.com để có hạn mức token miễn phí mỗi ngày.
# Muốn dùng nhà cung cấp khác, trỏ LLM_BASE_URL tới endpoint tương thích OpenAI (ví dụ LiteLLM proxy).
LLM_BASE_URL=https://api.openai.com/v1
# Key OpenAI (cùng key đã đặt trên Vercel). Đặt LLM_API_KEY thay thế nếu dùng nhà cung cấp khác.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.4
LLM_DAILY_TOKENS=230000
# Hết phần của model chính trong ngày thì chuyển sang model này
LLM_FALLBACK_MODEL=gpt-5.4-mini
LLM_FALLBACK_DAILY_TOKENS=2300000
# Giá VND cho 1 triệu token, để 0 khi còn trong hạn mức miễn phí
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Trang công khai (Cloudflare Pages) và token ghi sổ cái
# Địa chỉ trang sau khi deploy (Vercel hoặc Cloudflare)
SITE_URL=https://mony.vercel.app
SITE_ADMIN_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789

# Lớp kiểm soát: đơn trên ngưỡng này cần người duyệt
APPROVAL_THRESHOLD_VND=2000000
DATA_DIR=./data
START_DATE=2026-10-28
