{
  "name": "mony-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:init": "wrangler d1 execute mony --remote --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "typecheck:vercel": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --skipLibCheck --types node --lib ES2022,DOM api/*.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "grammy": "^1.46.0",
    "postgres": "^3.4.9"
  }
}
